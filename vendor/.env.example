# Copy to .env and fill in. Never commit .env itself.

VENDOR_PORT=4100
NODE_ENV=development

# The vendor service's OWN database. It may share a cluster with the
# product for local work, but must be a separate database — an order
# queue and a customer's operational data should not share a blast
# radius. Falls back to MONGO_URI only for convenience in development.
VENDOR_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
VENDOR_DB_NAME=silla_vendor

# Signs storefront sessions. Use a DIFFERENT secret from the product's:
# a token minted for a buyer's deployment must not be accepted here.
JWT_SECRET=replace-with-a-long-random-string

# The portal's origin.
CORS_ORIGINS=http://localhost:5174

# ---- Email ----
# vendor/ has its OWN COPY of the email service, not an import from
# server/ — the two must never cross-import.
#
# Unlike server/, this copy is SMTP-ONLY. There is no Resend path here,
# so EMAIL_API_KEY is read nowhere in vendor/ and setting it does
# nothing: without SMTP_USER + SMTP_PASSWORD every buyer welcome, order
# receipt and status-change mail is written to the console instead of
# being sent, and nothing warns you.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM=no-reply@example.com

# Where "a buyer submitted an order" lands. Unset = no internal notice.
SILLA_ORDERS_EMAIL=

# ---- Staff ----
# There is deliberately NO HTTP route that creates a SILLA staff account.
# Mint one from the CLI instead:
#   npm run seed:staff -- you@example.com "Your Name" <password>
#
# The order suite signs in as that account, so it needs the same
# credentials to run:
#   VENDOR_STAFF_EMAIL=… VENDOR_STAFF_PASSWORD=… npm test
VENDOR_STAFF_EMAIL=
VENDOR_STAFF_PASSWORD=

# Where the suite points. Defaults to http://localhost:4100.
# VENDOR_API_URL=

# Billing (not wired yet — see CLAUDE.md).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
