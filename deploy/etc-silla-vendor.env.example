# ---------------------------------------------------------------------
# /etc/silla/vendor.env  —  the commerce API
#
#   sudo install -m 640 -o root -g silla this-file /etc/silla/vendor.env
# ---------------------------------------------------------------------

NODE_ENV=production
TZ=Asia/Manila

VENDOR_PORT=4100

# The vendor service's OWN database. VENDOR_MONGO_URI is preferred and
# falls back to MONGO_URI. The database name comes from VENDOR_DB_NAME
# and IS passed explicitly to mongoose, which is why this genuinely is a
# separate database rather than a second set of collections.
VENDOR_MONGO_URI=
VENDOR_DB_NAME=silla_vendor

# The fallback, read only when VENDOR_MONGO_URI is empty. Setting just
# this one works, but db.js's error message names VENDOR_MONGO_URI when
# BOTH are missing, which sends you to the wrong variable — so prefer
# setting VENDOR_MONGO_URI above and leaving this blank.
MONGO_URI=

# MUST DIFFER from the product API's JWT_SECRET. A token minted for a
# buyer's deployment must not be accepted by our order queue.
#   openssl rand -hex 32
JWT_SECRET=

# The portal's CloudFront URL.
CORS_ORIGINS=

# ---- Email. NOTE: vendor/ has its own COPY of the email service and it
# is SMTP-ONLY — there is no Resend path here, so EMAIL_API_KEY is read
# nowhere in vendor/. Without SMTP_USER + SMTP_PASSWORD every buyer
# welcome, order receipt and status-change mail is written to the
# console instead of being sent, and nothing warns you. ----
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM=

# Where "a buyer submitted an order" lands. Unset = no internal notice
# is sent and you find out by refreshing the queue.
SILLA_ORDERS_EMAIL=

# Read only by vendor/tests/ — VENDOR_API_URL, VENDOR_STAFF_EMAIL and
# VENDOR_STAFF_PASSWORD. Not needed by the running service.
