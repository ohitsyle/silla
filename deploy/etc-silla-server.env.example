# ---------------------------------------------------------------------
# /etc/silla/server.env  —  the product API
#
#   sudo install -d -m 750 -o root -g silla /etc/silla
#   sudo install -m 640 -o root -g silla this-file /etc/silla/server.env
#
# Mode 640 root:silla — the service can read it, nobody else can. It
# lives outside /opt/silla so `git pull` cannot overwrite it and
# `git add -A` cannot commit it.
#
# Every variable below is one the code actually reads. Derived by
# grepping process.env across server/ — NOT copied from
# server/.env.example, which was missing the whole SMTP block.
# ---------------------------------------------------------------------

NODE_ENV=production

# MANDATORY. Operating-hours checks use process-local time, so on a
# default-UTC box the kiosk refuses bookings all through the Philippine
# working day and only starts working after 17:00 local.
TZ=Asia/Manila

PORT=4000

# Copy from your laptop's server/.env BYTE FOR BYTE. The working URI has
# no database in its path, so Mongo falls back to its default and all
# product collections live in a database literally named `test`. Adding
# a tidier database name silently connects you to an empty one.
MONGO_URI=

# A long random string. Generate with:  openssl rand -hex 32
# Must DIFFER from the vendor service's secret.
JWT_SECRET=

# Comma-separated, no spaces. Must be the CloudFront URL of the client
# SPA once it exists. If this is empty the REST API still answers (it
# falls back to reflecting the origin) but you lose the allowlist, so
# set it. Include the portal's URL too if you ever point it here.
#   e.g. https://d111111abcdef8.cloudfront.net
CORS_ORIGINS=

# ---- Email (SMTP wins over EMAIL_API_KEY; with neither, it logs to
# console AND three endpoints start returning live codes in responses —
# though NODE_ENV=production above closes that on its own) ----
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM=

# Only if you switch away from SMTP to Resend. Leave blank otherwise.
EMAIL_API_KEY=

# Not needed in production — TEST_API_URL and TEST_ORG_ID are read only
# by server/tests/ and are listed here so you know they exist.
