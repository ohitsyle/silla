# SILLA commerce API — buyer accounts and the order queue.
#
# Deliberately a separate service from the product API: server/ is what
# a buyer is given, and putting our order queue inside it would ship the
# customer list to every customer. Different database, different
# JWT_SECRET, so a token minted here is rejected there.
#
# Install:  sudo cp silla-vendor.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now silla-vendor

[Unit]
Description=SILLA commerce API (buyer accounts + order queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=silla
Group=silla
WorkingDirectory=/opt/silla/vendor
ExecStart=/usr/bin/node src/server.js

# Secrets live OUTSIDE the git checkout so a `git pull` can never
# clobber them and a stray `git add -A` can never commit them.
EnvironmentFile=/etc/silla/vendor.env

# Defaults, in case the env file forgets them. TZ is not optional:
# operating-hours checks call date.getHours() in process-local time
# (services/reservations/availability.js), so on a default-UTC box the
# kiosk refuses every booking during Philippine working hours.
Environment=NODE_ENV=production
Environment=TZ=Asia/Manila

Restart=always
RestartSec=5
# Don't thrash if it is crash-looping on a bad env file.
StartLimitIntervalSec=60
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=silla-vendor

# Modest hardening. The process needs outbound network (Atlas, SMTP)
# and read access to its own checkout; nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/silla

[Install]
WantedBy=multi-user.target
