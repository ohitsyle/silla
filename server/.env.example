# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (free tier)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# Used to sign login sessions/tokens — generate a long random string
JWT_SECRET=replace-with-a-long-random-string

# ---- Email ----
# The transport is chosen at import time, in this order:
#   SMTP_USER + SMTP_PASSWORD  ->  nodemailer over SMTP   (what we use)
#   EMAIL_API_KEY              ->  Resend's HTTP API
#   neither                    ->  console, and registration/reset
#                                  endpoints return the code in the
#                                  response so the kiosk is testable
#
# Gmail needs an APP PASSWORD, not the account password, and the account
# needs 2-Step Verification switched on first:
#   https://myaccount.google.com/apppasswords
# Paste it WITHOUT the spaces Google shows it with.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Only if you use Resend instead of SMTP. Note Resend will not send from
# a domain you have not verified with them.
EMAIL_API_KEY=

# The From: address. With Gmail SMTP this must be the SMTP_USER account.
EMAIL_FROM=no-reply@example.com

# Prove delivery before anything depends on it:
#   npm run email:test -- you@yourdomain.com

# Comma-separated origins allowed to call this API (your client dev URL, prod URL)
CORS_ORIGINS=http://localhost:5173
