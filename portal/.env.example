# The portal runs without any of this — every value below has a working
# localhost default, so `npm run dev` on a fresh clone just works. Copy
# to .env only when a service is somewhere other than this machine.

# SILLA's commerce API (vendor/), which serves sign-in and the order
# queue. Defaults to http://localhost:4100.
# VITE_VENDOR_API_URL=http://localhost:4100
